{
  "name": "miwim",
  "version": "1.0.0",
  "description": "Convert in-text citations in a .docx into real, linked Word footnotes — entirely in the browser.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "miwim.core.js",
  "files": [
    "index.html",
    "miwim.core.js",
    "miwim.docx.js",
    "serve.js",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:watch": "node --test --watch \"tests/*.test.js\"",
    "test:browser": "node tests/browser/run.js",
    "serve": "node serve.js"
  },
  "devDependencies": {
    "@xmldom/xmldom": "^0.9.0",
    "jszip": "^3.10.1"
  },
  "keywords": ["docx", "ooxml", "citations", "footnotes", "references", "bibliography", "harvard", "apa"],
  "engines": { "node": ">=18.0.0" }
}
